# Environment Variables Configuration Template
# Copy this file to .env and adjust sensitive values for local or server environments.

# Application Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aida_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication (HS256 requires minimum 256-bit key - 64 hex characters)
JWT_SECRET=replace_with_a_64_character_hex_or_256_bit_secret_key_here_123456
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=aida-platform

# CORS Settings (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173